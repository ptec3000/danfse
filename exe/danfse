#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "danfse"

options = {situacao: :normal, canhoto: false}
situations = []
parser = OptionParser.new do |cli|
  cli.banner = "Uso: danfse [--cancelada | --substituida] [--canhoto] entrada.xml [saida.pdf]"
  cli.on("--cancelada", "Marca a NFS-e como cancelada") { situations << :cancelada }
  cli.on("--substituida", "Marca a NFS-e como substituída") { situations << :substituida }
  cli.on("--canhoto", "Inclui o canhoto de recebimento") { options[:canhoto] = true }
end

begin
  parser.parse!
  if situations.uniq.length > 1
    raise OptionParser::InvalidArgument, "--cancelada e --substituida são incompatíveis"
  end
  unless (1..2).cover?(ARGV.length)
    warn parser
    exit 64
  end
rescue OptionParser::ParseError => error
  warn error.message
  warn parser
  exit 64
end

options[:situacao] = situations.first unless situations.empty?
$stdout.binmode

begin
  if ARGV[1]
    Danfse.render_file(ARGV[0], ARGV[1], **options)
  else
    $stdout.write(Danfse.render(File.binread(ARGV[0]), **options))
  end
rescue Danfse::InvalidXml => error
  warn "XML da NFS-e inválido: #{error.message}"
  exit 1
rescue Danfse::Error, ArgumentError => error
  warn "Erro ao gerar PDF: #{error.message}"
  exit 1
rescue SystemCallError => error
  warn "Erro ao acessar arquivo: #{error.message}"
  exit 1
end
